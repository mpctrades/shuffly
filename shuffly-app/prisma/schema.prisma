// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// ============ Shuffly domain models ============

// Per-shop settings (Settings screen + plan + onboarding state)
model ShopSettings {
  id                  String    @id @default(cuid())
  shop                String    @unique
  timezone            String    @default("UTC")
  defaultRunTime      String    @default("06:00") // "HH:MM", local to `timezone`
  language            String    @default("en") // "en" | "fr"
  neverMoveTags       String    @default("gift-card,preorder,bundle") // comma-separated
  emailOnFailure      Boolean   @default(true)
  emailMonthlySummary Boolean   @default(true)
  emailMorningRun     Boolean   @default(false)
  autoSwitchToManual  Boolean   @default(false) // "Switch automatically from now on, don't ask again" —
                                                 // set from the add-collections dialog. Revocable on the
                                                 // Settings page: a consent the merchant can't withdraw
                                                 // isn't consent.
  onboardedAt         DateTime?
  pageSize            Int       @default(24) // products per page in the merchant's theme — Shopify's Admin
                                              // API has no way to read this, so it's a manual setting with
                                              // 24 (Shopify's common default) as the fallback. Drives every
                                              // "page 1" Insights metric.
  plan                String    @default("FREE") // FREE | STARTER | PRO
  planUpdatedAt       DateTime?
  activeSubscriptionId String? // gid://shopify/AppSubscription/... — set once billing.check() confirms it
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

// One row per Shopify collection that's been added to Shuffly
model CollectionConfig {
  id             String    @id @default(cuid())
  shop           String
  collectionGid  String // gid://shopify/Collection/...
  title          String // cached label, refreshed on load
  productCount   Int       @default(0)
  status         String    @default("RUNNING") // RUNNING | PAUSED
  previousSortOrder String? // what Collection.sortOrder was before we switched it to MANUAL, if we did
  originalOrder  String?  // The product order this collection had the moment it was added to Shuffly,
                          // as a JSON array of NUMERIC product ids (the "gid://shopify/Product/" prefix
                          // is stripped — it's a quarter of the bytes on a 2000-product collection).
                          // Deliberately NOT the same thing as ShuffleRun.previousOrder: that is a
                          // per-run snapshot which pruneExpiredUndoSnapshots deletes after the plan's
                          // retention window (1 day on Free), so it cannot back a "restore what it looked
                          // like before Shuffly" promise. This column is never pruned.
  originalOrderAt DateTime? // when originalOrder was captured; null means we have no snapshot, and the
                            // remove dialog says so rather than promising a restore it can't do.
  pins           Int       @default(0) // "pin the first N" — these never move
  pushSoldOutToEnd Boolean @default(true)
  boostNewArrivals Boolean @default(true)
  giveEveryoneATurn Boolean @default(true) // fairness: least-recently-featured first
  newArrivalDays Int       @default(14) // a product counts as "new" if created within N days
  scheduleType   String    @default("DAILY") // DAILY | TWICE_DAILY | WEEKLY | MANUAL
  scheduleTime   String    @default("06:00") // "HH:MM" local time — the first (or only) time slot
  scheduleTime2  String?   // "HH:MM" local time for the SECOND slot, used only when
                           // scheduleType=TWICE_DAILY (a Pro entitlement). Before
                           // merchants could pick it, the second slot was derived as
                           // scheduleTime + 12h; existing rows were backfilled to that
                           // same value so nobody's schedule moved.
  scheduleWeekday Int?     // 0=Sunday..6=Saturday, used when scheduleType=WEEKLY
  scheduleUpdatedAt DateTime? // when the merchant last changed any schedule field. The sweep's
                              // grace window is only honoured for slots due AFTER this instant,
                              // which is what tells "the worker was down, run it late" apart
                              // from "the merchant just moved this slot into the past, don't
                              // back-fire". Without it those two are indistinguishable.
  lastRunAt      DateTime?
  lastSoldOutCount Int?    // sold-out products pushed to the end on the most recent run — real, not estimated
  lastKnownOrder String?  // JSON array of product GIDs — exactly what we last wrote to Shopify, so the next
                          // run can tell whether a merchant has since dragged things around by hand
  nextRunAt      DateTime?
  turnCounts     String    @default("{}") // JSON map: productId (numeric) -> times featured, for fairness
  priorityBoostIds String  @default("[]") // JSON array of product GIDs to lead the very next run, then cleared —
                                          // set by Insights' "Put these first tomorrow"
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  runs ShuffleRun[]
  exposures ProductExposure[]
  snapshots PositionSnapshot[]
  positions ProductPosition[]
  slotClaims ShuffleSlotClaim[]

  @@unique([shop, collectionGid])
  @@index([shop])
  @@index([status, nextRunAt])
}

// One row per (collection, shop-local day, time slot) that a scheduled run
// has been claimed for. The unique constraint IS the idempotency guard: the
// cron sweep inserts the claim *before* it runs the shuffle, so a slot fires
// exactly once per local calendar day per collection even when two sweeps
// overlap, a sweep is retried, or the shop's wall clock repeats an hour on a
// DST fall-back day. Rows older than the retention window are pruned by the
// sweep itself — see pruneOldSlotClaims in cron.server.ts.
model ShuffleSlotClaim {
  id           String   @id @default(cuid())
  shop         String
  collectionId String
  collection   CollectionConfig @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  dateKey      String   // "YYYY-MM-DD" in the shop's own timezone
  slot         Int      // 0 = first time slot, 1 = second (twice-daily's later run)
  scheduledFor DateTime // the UTC instant this slot resolved to — kept for diagnosing DST edges
  claimedAt    DateTime @default(now())

  @@unique([collectionId, dateKey, slot])
  @@index([shop, claimedAt])
}

// A single shuffle/reorder event — powers the Workspace "History" tab, the
// Activity screen, and Undo.
model ShuffleRun {
  id            String    @id @default(cuid())
  shop          String
  collectionId  String
  collection    CollectionConfig @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  trigger       String // SCHEDULED | MANUAL | SOLD_OUT_REACTION | RESTOCK_REACTION | EXTERNAL_REORDER_DETECTED | PAUSED | RESUMED | SCHEDULE_CHANGED | SORT_CHANGED | SORT_RESTORED
  status        String // OK | FAILED
  movedCount    Int       @default(0)
  pinnedCount   Int       @default(0)
  soldOutCount  Int       @default(0)
  durationMs    Int       @default(0)
  message       String? // human-readable summary line, or error detail
  previousOrder String? // JSON array of product GIDs, in order, before this run — used to Undo
  batchId       String? // shared by every collection shuffled in the same sweep (a cron tick, or one "Shuffle all now"), so the Activity feed can show them as a single entry
  createdAt     DateTime  @default(now())

  @@index([shop, createdAt])
  @@index([shop, batchId])
  @@index([collectionId, createdAt])
}

// One row per product actually observed in a collection's live order —
// created the first time a product is fetched for a run (regardless of
// position), then updated only while it's within the top PAGE1_SIZE
// positions. Powers Insights' "seen on page 1", "first time in top 20", and
// "still never seen" — all computed from Shuffly's own history, no
// storefront analytics, no extra scopes.
model ProductExposure {
  id               String    @id @default(cuid())
  shop             String
  collectionId     String
  collection       CollectionConfig @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  productGid       String
  productTitle     String
  firstSeenPage1At DateTime? // null = never once held a page-1 position
  lastSeenPage1At  DateTime? // most recent time it held a page-1 position
  firstSeenTop20At DateTime? // null = never once held a top-20 position
  updatedAt        DateTime  @updatedAt

  @@unique([shop, collectionId, productGid])
  @@index([shop, collectionId])
  @@index([shop, lastSeenPage1At])
}

// One row per (collection, local calendar day) a run actually happened —
// upserted, so multiple runs on the same day update today's row rather than
// double-counting. Powers the "sold-out sitting near the top" trend and its
// day-of-install baseline.
model PositionSnapshot {
  id                String   @id @default(cuid())
  shop              String
  collectionId      String
  collection        CollectionConfig @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  dateKey           String   // "YYYY-MM-DD" in the shop's own timezone
  soldOutTop20Count Int
  capturedAt        DateTime @default(now())

  @@unique([shop, collectionId, dateKey])
  @@index([shop, dateKey])
  @@index([shop, capturedAt])
}

// One row per product per run, but only for products that actually landed
// on page 1 (position <= the shop's pageSize) — recording the rest would
// grow unboundedly for no metric this app needs, since every Insights
// figure only cares about "did this reach page 1 / the top 20", never a
// product's exact rank further down. `position` is 1-based, matching the
// "position <= pageSize" language every metric definition uses. Supersedes
// ProductExposure/PositionSnapshot's lifetime-only aggregates with real,
// range-queryable history; those two tables are left in place (existing
// data, no longer written to) rather than dropped.
model ProductPosition {
  id               String   @id @default(cuid())
  shop             String
  collectionId     String
  collection       CollectionConfig @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  productGid       String
  position         Int // 1-based
  availableForSale Boolean
  dateKey          String // "YYYY-MM-DD" in the shop's own timezone — the heatmap's day bucket
  recordedAt       DateTime @default(now())

  @@index([shop, collectionId, dateKey])
  @@index([shop, dateKey])
  @@index([shop, productGid, dateKey])
}
